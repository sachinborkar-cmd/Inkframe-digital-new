# Server & Environment
PORT=8000
NODE_ENV=development
APP_ORIGIN=http://localhost:8000
SESSION_SECRET=your-random-session-secret-at-least-32-chars

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=ebook_store

# Authentication & Admin
ADMIN_EMAIL=
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Payments
# Development test checkout flag (must be false in production)
TEST_PAYMENTS_ENABLED=false
# Live Razorpay configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Transactional Email
# Option A: Resend (Recommended for production)
RESEND_API_KEY=
EMAIL_FROM=

# Option B: SMTP (Legacy / Development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Inkframe Press

# Private eBook Storage (AWS S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

