{
  "name": "inkframe-press",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --watch-path=server --watch-path=.env server/server.js",
    "start": "node server/server.js",
    "check": "node --check server/server.js && node --check client/assets/js/auth.js && node --check client/assets/js/site.js",
    "check:email": "node client/assets/scripts/check-email.js",
    "test:checkout": "node client/assets/scripts/test-checkout.js",
    "test:razorpay": "node client/assets/scripts/test-razorpay.js",
    "test:s3": "node client/assets/scripts/test-s3.js",
    "test:order-numbering": "node client/assets/scripts/test-order-numbering.js",
    "test:admin": "node client/assets/scripts/test-admin.js",
    "test:product": "node client/assets/scripts/test-product.js",
    "test:security": "node client/assets/scripts/test-security.js",
    "test:http": "node client/assets/scripts/test-http.js",
    "test": "vitest run",
    "test:session-store": "node client/assets/scripts/test-session-store.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.2",
    "google-auth-library": "^11.0.2",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.3",
    "razorpay": "^2.9.8",
    "resend": "^6.30.0"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "smtp-server": "^3.19.10",
    "vitest": "^5.0.0"
  },
  "files": [
    "server/",
    "client/index.html",
    "client/pages/",
    "client/library/",
    "client/ebooks/",
    "client/assets/css/",
    "client/assets/js/",
    "client/assets/fonts/",
    "client/assets/images/",
    "client/assets/uploads/",
    ".env.example"
  ]
}
