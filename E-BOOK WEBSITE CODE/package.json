{
  "name": "inkframe-press",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --watch-path=server --watch-path=.env server/server.js",
    "start": "node server/server.js",
    "check": "node --check server/server.js && node --check client/assets/js/auth.js && node --check client/assets/js/site.js",
    "check:email": "node client/assets/scripts/check-email.js",
    "test:checkout": "node client/assets/scripts/test-checkout.js",
    "test:admin": "node client/assets/scripts/test-admin.js",
    "test:product": "node client/assets/scripts/test-product.js",
    "test:security": "node client/assets/scripts/test-security.js",
    "test:http": "node client/assets/scripts/test-http.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.2",
    "google-auth-library": "^11.0.2",
    "mysql2": "^3.14.5",
    "nodemailer": "^7.0.6"
  }
}
